# Monolith OS Kernel Configuration — ARM64 Server (6.12 LTS)
# Optimized for ARM64 server platforms: Graviton, Ampere Altra, Apple Silicon M-series

# General
CONFIG_LOCALVERSION="-monolith"
CONFIG_DEFAULT_HOSTNAME="monolith"

# Module support — see the long comment in x86_64.config. Verified here
# too: `make ARCH=arm64 olddefconfig` resolves Kconfig text without
# needing an actual ARM64 cross-compiler, so this isn't a blind mirror
# of the x86_64 fix — confirmed CONFIG_MODULES was silently absent on
# this arch's fragment as well.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_SHA256=y

# Processor — ARM64
CONFIG_ARM64=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y
CONFIG_ARCH_SUPPORTS_HUGE_VMAP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256

# 6.12 LTS: Memory Tagging Extension — hardware-level memory safety
CONFIG_ARM64_MTE=y
CONFIG_ARM64_E0PD=y

# 6.12 LTS: Memory Partitioning and Monitoring
CONFIG_ARM64_MPAM=y

# 6.12 LTS: Scheduler cluster support (big.LITTLE / DSU clusters)
CONFIG_SCHED_CLUSTER=y

# 6.12 LTS: Protected KVM (pKVM) for hardened guest isolation
CONFIG_PKVM=y

# 6.12 LTS: Rust-for-Linux (stable in 6.12)
CONFIG_RUST=y

# NUMA
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y

# Transparent Huge Pages
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Scheduler — see the long comment in configs/x86_64.config: BORE isn't
# a real Kconfig symbol in this tree, sched_ext is, use that instead.
# DEBUG_INFO_BTF needs the same DEBUG_KERNEL -> "Debug information"
# chain as x86_64 (was missing here — DEBUG_INFO_BTF alone silently
# dropped, same failure mode as everything else on this page). Verified
# against the real Kconfig tree with ARCH=arm64, not blindly mirrored.
CONFIG_SCHED_CLASS_EXT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_NO_HZ_FULL=y

# Networking — same as x86_64
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_WIREGUARD=y
CONFIG_MPTCP=y
CONFIG_XDP_SOCKETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# Storage & I/O
#
# Unlike x86_64, PCI itself already resolves to y on arm64 without
# being requested (an arch-level default pulls it in) — verified, not
# assumed. ATA and NETDEVICES don't get the same free ride though: both
# are `menuconfig` gates with no default here either, and were silently
# dropping SATA_AHCI/VIRTIO_NET exactly like on x86_64.
CONFIG_PCI=y
CONFIG_ATA=y
CONFIG_NETDEVICES=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_DM_CRYPT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_BTRFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_IO_URING=y
CONFIG_MQ_IOSCHED_KYBER=y

# Virtualization
CONFIG_KVM=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VHOST_NET=y

# Security
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Containers
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# Disabled — not needed on servers
CONFIG_SOUND=n
CONFIG_BT=n
# See the long comment in x86_64.config: WIRELESS=n alone is a no-op,
# menuconfig WLAN force-selects it with its own default y. Verified the
# same way (ARCH=arm64 olddefconfig), same fix applies.
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_USB_HID=n
CONFIG_DRM=n
CONFIG_PCMCIA=n
CONFIG_FIREWIRE=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_MEDIA_SUPPORT=n
