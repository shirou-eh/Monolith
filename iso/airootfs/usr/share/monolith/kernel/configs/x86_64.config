# Monolith OS Kernel Configuration — x86_64 Server
# Optimized for server workloads: networking, storage, containers, VMs
# Based on latest stable Linux kernel

# General
CONFIG_LOCALVERSION="-monolith"
CONFIG_DEFAULT_HOSTNAME="monolith"

# Module support — `menuconfig MODULES` (kernel/module/Kconfig) has no
# kernel default either. Without it every `=m` request anywhere in this
# fragment (or any overlay merged on top of it, e.g. x86_64-desktop.config)
# silently collapses to built-in — no error, `make olddefconfig` just
# treats 'm' as unavailable and picks 'y' instead. That means this
# kernel was compiling everything directly into vmlinuz with zero
# loadable-module capability: no DKMS, no out-of-tree drivers (NVIDIA
# proprietary, VirtualBox, ZFS), no dynamic hardware support, and a
# needlessly bloated always-resident image. MODULE_UNLOAD/SIG are the
# same defaults any mainstream distro kernel ships.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_SHA256=y

# Processor
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_X86_FSGSBASE=y
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=y
CONFIG_X86_MCE=y
CONFIG_RETPOLINE=y
CONFIG_GENERIC_CPU_VULNERABILITIES=y

# SIMD / AVX
CONFIG_X86_AVX=y
CONFIG_X86_AVX2=y
CONFIG_X86_AVX512=y

# NUMA
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_NUMA_BALANCING_DEFAULT_ENABLED=y

# Transparent Huge Pages
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Scheduler
# CONFIG_SCHED_BORE doesn't exist as a Kconfig symbol in this tree — BORE
# was never merged upstream as a plain compile-time option, so
# olddefconfig silently dropped it and the kernel stayed on stock
# CFS/EEVDF. What this tree DOES ship for real: sched_ext (SCX), the
# actual in-tree framework for swapping in a BPF scheduler like scx_bore
# or scx_rusty without a kernel patch or rebuild — closer to what BORE
# was reaching for, and it survives olddefconfig because the symbol is
# real. Needs DEBUG_INFO_BTF (BTF type info for BPF) on top of the
# BPF_SYSCALL/BPF_JIT already enabled below.
CONFIG_SCHED_CLASS_EXT=y
# DEBUG_INFO_BTF depends on the "Debug information" choice (which itself
# depends on DEBUG_KERNEL) actually being set to something other than
# DEBUG_INFO_NONE — BTF is generated *from* DWARF debug info, so without
# asking for debug info at all there's nothing for pahole to convert.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_NO_HZ_FULL=y

# Networking — Performance
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
# TCP_CONG_BBR lives inside an `if TCP_CONG_ADVANCED` block in Kconfig —
# setting TCP_CONG_BBR=y alone (as this fragment used to) doesn't help
# if the guarding menuconfig itself is never turned on; olddefconfig
# treats the whole block as unset and falls back to cubic. This is the
# actual reason BBR didn't survive olddefconfig in the last build.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_WIREGUARD=y
CONFIG_MPTCP=y
CONFIG_XDP_SOCKETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_IPVTUN=y

# Physical NICs — this fragment previously only requested VIRTIO_NET,
# so a real server (not a VM) had no way to reach the network at all.
# Modules, loaded via the mkinitcpio 'autodetect'/'block'/'net' hooks
# already in use, covering the common real-hardware vendors: Intel
# (onboard/1G/10G), Realtek (consumer/prosumer boards) and Broadcom
# (common in server-grade NICs and BMCs).
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNX2=m

# Storage & I/O
#
# CONFIG_PCI is the actual root of the PCI subsystem (`menuconfig PCI`
# in drivers/pci/Kconfig — no default, has to be requested explicitly).
# It was missing here entirely, and every driver below silently
# depends on it: NVMe, SATA_AHCI and VIRTIO_PCI/BLK/NET all vanish
# without a trace under `make olddefconfig` — no warning, they just
# stop being reachable. That means this "server" kernel would not find
# its own root disk or NIC on real hardware or in a virtio-backed VM.
# Confirmed by actually resolving the fragment against the real 7.1.8
# Kconfig tree and grepping the result, same as the BBR/sched_ext fix.
CONFIG_PCI=y
# Same story as PCI: ATA and NETDEVICES are `menuconfig` gates with no
# kernel default (NETDEVICES defaults to y only under UML). Without
# these, SATA_AHCI/E1000E/IXGBE/R8169/VIRTIO_NET below are unreachable
# the exact same silent way PCI's absence broke storage — verified the
# same way, by resolving against the real Kconfig tree and checking
# what actually survived.
CONFIG_ATA=y
CONFIG_NETDEVICES=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_DM_CRYPT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_BTRFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_IO_URING=y
CONFIG_MQ_IOSCHED_KYBER=y

# Virtualization
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VHOST_NET=y

# Security
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20_X86_64=y

# Containers
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# Disabled — not needed on servers
CONFIG_SOUND=n
CONFIG_BT=n
# WIRELESS=n alone was always a no-op: `menuconfig WLAN` (the actual
# on-disk driver menu) has `default y` and unconditionally `select
# WIRELESS` — a `select` wins over the selected symbol's own explicit
# value, so the whole WLAN driver menu was silently building in
# regardless of this line. Disabling WLAN itself is what actually
# blocks it; verified, this is the only symbol in this block with that
# force-select trap (checked every other line here for the same thing).
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_USB_HID=n
CONFIG_DRM=n
CONFIG_DRM_I915=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_PCMCIA=n
CONFIG_FIREWIRE=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_MEDIA_SUPPORT=n
