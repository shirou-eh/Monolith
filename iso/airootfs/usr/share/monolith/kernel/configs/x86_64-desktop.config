# Monolith OS — x86_64 desktop overlay
#
# The base x86_64.config is server-only: it explicitly disables sound,
# wireless, Bluetooth, USB HID and every DRM driver on the assumption
# there's no keyboard/mouse/display attached beyond a serial console.
# That's a real problem on non-server hardware — a desktop or laptop
# boot of Monolith with the plain server config has no working input
# or graphics.
#
# This is NOT a standalone config — it's a fragment merged on top of
# x86_64.config via `scripts/kconfig/merge_config.sh` (see
# kernel/build.sh's select_config(), --profile desktop). Only lists the
# symbols that need to flip relative to the server base; everything
# else (scheduler, BBR, BTF, cgroups, filesystem support, ...) is
# inherited unchanged.
#
# GPU drivers are built as modules (=m), not builtin — keeps the
# desktop kernel able to run on any of the three vendors without
# hardcoding one, and modules_install already ships them via mkinitcpio.

# Human input — was USB_HID=n, no keyboard/mouse on a USB-only board.
# USB_HID sits under `menu "USB HID support" depends on USB`, and the
# server base config never turns on CONFIG_USB (the host-side USB core)
# at all — verified by `make olddefconfig` silently dropping USB_HID
# with no USB core to hang off of. xHCI is the standard USB3 host
# controller on any x86_64 built in the last decade-plus; built in
# (not module) so a USB keyboard works at the installer/live-boot stage
# before modules are loaded from disk.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=m
CONFIG_INPUT_TOUCHSCREEN=y
# INPUT_JOYSTICK is bool upstream in 7.1, not tristate — "=m" is invalid
# and silently dropped by olddefconfig. Builtin costs nothing since it's
# tiny and only matters if a joystick is plugged in.
CONFIG_INPUT_JOYSTICK=y

# Display — was DRM=n, no graphics output at all
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_FB=y

# Audio — was SOUND=n
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m

# Wireless + Bluetooth — a laptop without either is dead on arrival.
# WLAN, not just WIRELESS, has to flip back on: WLAN force-`select`s
# WIRELESS with its own `default y`, which is exactly the trap the base
# config's WIRELESS=n fell into — setting WIRELESS=y alone here would
# work today only because nothing re-disables WLAN downstream, but
# being explicit about the symbol that actually gates the driver menu
# is what's correct, not what happens to still work.
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m

# Webcams etc. Left as module so it's opt-in weight, not opt-in function.
CONFIG_MEDIA_SUPPORT=m

# PCMCIA and FireWire stay off — not present on any hardware from the
# last decade-plus that would run this kernel; server and desktop agree
# here, so no override needed.
