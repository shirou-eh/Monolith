[Unit]
Description=Monolith OS boot self-test (CI only — inert without monolith.selftest on the kernel cmdline)
ConditionKernelCommandLine=monolith.selftest
# Runs after the live environment is actually up (networking, the rest
# of multi-user.target) so the checks reflect a genuinely booted
# system, not a half-started one that would fail for unrelated reasons.
After=multi-user.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/monolith-selftest
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
