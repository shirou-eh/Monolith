# Monolith OS — packages installed in the live/install ISO image (x86_64)
# Keep this list lean: the live ISO is meant for installing, not full use.

# --- Base ---
base
base-devel
linux
linux-firmware
mkinitcpio
# Provides the archiso/archiso_loop_mnt/archiso_pxe_* mkinitcpio hooks —
# without this, mkarchiso's own initramfs build inside the live rootfs
# fails with "Hook 'archiso' cannot be found" and produces no ISO at all.
mkinitcpio-archiso
syslinux
grub
efibootmgr
edk2-shell
arch-install-scripts
btrfs-progs
xfsprogs
e2fsprogs
dosfstools
parted
gptfdisk
lvm2
cryptsetup
mdadm
sudo
which
nano
vim
git
curl
wget
htop
iotop
iproute2
iputils
openssh
networkmanager
dhcpcd
wpa_supplicant
chrony
zsh
bash-completion

# --- Filesystems / archives ---
unzip
zip
tar
zstd

# --- Hardware support ---
amd-ucode
intel-ucode
nvme-cli
smartmontools
usbutils
pciutils
dmidecode
lshw

# --- Container/runtime base (so first boot is useful) ---
docker
docker-compose

# --- Cluster / package management dependencies ---
# etcd: `mnctl cluster init/join/quorum` shells out to etcd/etcdctl for
# real Raft-backed quorum — required by nothing else, so it has to be
# listed explicitly or a fresh install can't form a cluster at all.
# pacman-contrib: provides repo-add, required by `mnpkg repo add/build`
# (also required by nothing else — same story).
# gnupg (gpg) is NOT listed here: pacman itself hard-depends on it for
# official-repo signature verification, so it's already guaranteed
# present. Used by monolith-sign (self-update verification) and
# `mnpkg repo --sign`.
etcd
pacman-contrib

# --- Monolith control surfaces ---
# These are not in the official Arch repos; the ISO builder vendors the
# release tarball into airootfs/usr/local/bin/.
